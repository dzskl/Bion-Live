# Todos opcionais. O Bion Live funciona sem nenhum deles (voz do navegador + alertas no painel).
PORT=4000

# Voz premium (opcional). Sem isso o produto usa a voz nativa do navegador.
ELEVENLABS_API_KEY=

# Alerta no celular (opcional). Pode ser configurado pela interface tambem.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
