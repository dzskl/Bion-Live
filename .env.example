# Todos opcionais para uso local. O Bion Live funciona sem nenhum deles
# (voz do navegador + alertas no painel).
PORT=4000

# Trava de acesso. Vazio = sem senha (uso local).
# OBRIGATORIO antes de expor o painel numa URL publica: sem isso, qualquer um
# com o link ve seus produtos e consegue derrubar sua live.
BION_SENHA=

# Onde ficam o banco e os audios de seguranca. Na hospedagem, aponte para o volume.
# BION_DATA_DIR=/data

# Voz premium (opcional). Sem isso o produto usa a voz nativa do navegador.
ELEVENLABS_API_KEY=

# Alerta no celular (opcional). Pode ser configurado pela interface tambem.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
